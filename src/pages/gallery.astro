---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/blog.css";
import "../styles/gallery.css";
import gallery from "../data/gallery.json";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Though my lens — Dharitree Bezboruah</title>
  <script src="https://kit.fontawesome.com/2d462008c1.js" crossorigin="anonymous"></script>
</head>
<body>
  <Header />

  <main class="gallery-page">
    <div class="gallery-intro">
      <h1>Though my lens</h1>
      <p>I love travel, food, cinema. Feel free to browse some of my snapshots.</p>
    </div>

    <div class="gallery-grid">
      {gallery.map((image) => {
        const filename = image.filename;
        const encodedFilename = encodeURIComponent(filename);
        const localSrc = `${base}gallery/${encodedFilename}`;
        const rawSrc = `https://raw.githubusercontent.com/dbezboruah/website/astro-migration/public/gallery/${encodedFilename}`;

        return (
          <div class="gallery-item">
            <img
              src={localSrc}
              alt={filename}
              loading="lazy"
              data-fallback={rawSrc}
              onerror="if (this.src !== this.dataset.fallback) { this.src = this.dataset.fallback; }"
            />
          </div>
        );
      })}
    </div>
  </main>

  <Footer />
</body>
</html>
