---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="site-header">

  <h1>
    <a href={`${base}/`}>Dharitree Bezboruah</a>
  </h1>

  <nav>
    <a href={`${base}/`}>Home</a>
    <a href={`${base}/about/`}>About</a>
    <a href={`${base}/blog/`}>Blog</a>
    <a href={`${base}/gallery/`}>Gallery</a>
  </nav>

</header>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&display=swap');

  /* Keep the navigation visible while scrolling on every page. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: "DM Sans", sans-serif;
  }

  /* Match the landing-page header typography. */
  .site-header h1,
  .site-header h1 a,
  .site-header nav,
  .site-header nav a {
    font-family: "DM Sans", sans-serif;
  }
</style>
