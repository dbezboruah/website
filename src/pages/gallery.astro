---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/blog.css";
import "../styles/gallery.css";
import galleryImages from "../../public/gallery.json";

const images = Array.isArray(galleryImages) ? galleryImages : [];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Through my lens — Dharitree Bezboruah</title>
  <script src="https://kit.fontawesome.com/2d462008c1.js" crossorigin="anonymous"></script>
</head>
<body>
  <Header />

  <main class="gallery-page">
    <div class="gallery-intro">
      <h1>Through my lens</h1>
      <p>I love travel, food, cinema. Feel free to browse some of my snapshots.</p>
    </div>

    <div class="gallery-grid" id="galleryGrid" aria-live="polite">
      {images.length > 0 ? images.map((image, index) => (
        <button
          type="button"
          class="gallery-item"
          aria-label="Open gallery photo"
          data-index={index}
        >
          <img
            src={`${import.meta.env.BASE_URL}${image.src}`}
            alt="Gallery photo"
            loading="lazy"
            decoding="async"
          />
        </button>
      )) : (
        <p class="gallery-error">No photos available.</p>
      )}
    </div>
  </main>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close photo viewer">&times;</button>
    <button class="lightbox-prev" id="lightboxPrev" aria-label="Previous photo">&#10094;</button>
    <img class="lightbox-image" id="lightboxImage" src="" alt="Gallery photo" />
    <button class="lightbox-next" id="lightboxNext" aria-label="Next photo">&#10095;</button>
  </div>

  <Footer />

  <script is:inline>
    const galleryImages = Array.from(document.querySelectorAll(".gallery-item img")).map((img) => img.src);
    const galleryItems = Array.from(document.querySelectorAll(".gallery-item"));
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightboxImage");
    const lightboxClose = document.getElementById("lightboxClose");
    const lightboxPrev = document.getElementById("lightboxPrev");
    const lightboxNext = document.getElementById("lightboxNext");
    let currentIndex = 0;

    function openLightbox(index) {
      if (!galleryImages.length) return;
      currentIndex = (index + galleryImages.length) % galleryImages.length;
      lightboxImage.src = galleryImages[currentIndex];
      lightboxImage.alt = "Gallery photo";
      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.classList.add("lightbox-open");
    }

    function closeLightbox() {
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.classList.remove("lightbox-open");
      lightboxImage.removeAttribute("src");
    }

    function showPrevious() {
      openLightbox(currentIndex - 1);
    }

    function showNext() {
      openLightbox(currentIndex + 1);
    }

    galleryItems.forEach((item, index) => {
      item.addEventListener("click", () => openLightbox(index));
    });

    lightboxClose.addEventListener("click", closeLightbox);
    lightboxPrev.addEventListener("click", showPrevious);
    lightboxNext.addEventListener("click", showNext);

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (event) => {
      if (!lightbox.classList.contains("is-open")) return;
      if (event.key === "Escape") closeLightbox();
      if (event.key === "ArrowLeft") showPrevious();
      if (event.key === "ArrowRight") showNext();
    });
  </script>
</body>
</html>
