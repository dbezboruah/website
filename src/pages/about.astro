---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/about.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About — Dharitree Bezboruah</title>
    <link rel="stylesheet" href="https://kit.fontawesome.com/2d462008c1.js" />
  </head>

  <body>
    <Header />

    <main class="about-page">
      <section class="profile-intro">
        <div class="profile-heading">
          <p class="eyebrow">ABOUT</p>
          <h1>Dharitree Bezboruah</h1>
          <p class="role">PhD Scholar in Physics — Tezpur University, Assam</p>
          <p class="specialization">
            Astroparticle Physics · Neutrino Phenomenology · Cosmology · Machine Learning
          </p>
        </div>
      </section>

      <section class="about-grid">
        <section class="about-section">
          <h2>Current Occupation</h2>
          <div class="entry">
            <h3>Tezpur University, Assam</h3>
            <p>PhD in Physics (ongoing)</p>
            <p>Supervisor: Dr. Moon Moon Devi</p>
          </div>
        </section>

        <section class="about-section">
          <h2>Research Interests</h2>
          <ul>
            <li>Astroparticle Physics</li>
            <li>Neutrino Phenomenology</li>
            <li>Cosmology &amp; Machine Learning in Physics</li>
          </ul>
        </section>
      </section>

      <section class="about-section wide-section">
        <h2>Selected Publications</h2>
        <ol class="publication-list">
          <li>
            <strong>D. Bezboruah, D. S. Chattopadhyay, A. Medhi, A. Sarker, M. M. Devi</strong>,
            “Neutrino Oscillations in Presence of Diagonal Elements of Scalar NSI: An Analytic Approach”,
            <em>JHEP 12 (2025) 222</em> [arXiv:2410.05250].
          </li>
          <li>
            <strong>A. Sarker, A. Medhi, D. Bezboruah, M. M. Devi, D. Dutta</strong>,
            “Impact of scalar NSI on the neutrino mass hierarchy sensitivity at DUNE, HK, and KNO”,
            <em>JHEP 06 (2024) 128</em> [arXiv:2309.12249].
          </li>
          <li>
            <strong>A. Sarker, D. Bezboruah, A. Medhi, M. M. Devi, D. Dutta</strong>,
            “The Sensitivity of DUNE in Presence of Off-Diagonal Scalar NSI Parameters”,
            <em>arXiv:2406.15307</em>.
          </li>
        </ol>
      </section>

      <section class="about-section wide-section">
        <h2>Talks &amp; Conferences</h2>
        <ul class="talk-list">
          <li>“Analytic Approximation of Neutrino Oscillations in Presence of Scalar NSI” — TU-GradSciCon-2025.</li>
          <li>“Effect of scalar NSI on neutrino oscillations: An Analytic Approach (Poster)” — XXVI DAE-BRNS High Energy Physics Symposium 2024. <em>[Best Poster, Honorable Mention]</em></li>
          <li>“Dark Non-Standard Interaction and CP-phase measurement at DUNE (Poster)” — XXVI DAE-BRNS High Energy Physics Symposium 2024.</li>
          <li>“Impact of Scalar NSI on Neutrino Oscillations: An Analytic Approach” — PANE-2024.</li>
          <li>“Probing Non-Standard Interactions and CP-violation at DUNE via ν-oscillations (Poster)” — NEMA-X (2024).</li>
          <li>“Machine learning model for separation of muons from punch-through hadrons in EAS at GRAPES-3 experiment (Poster)” — ICRC 2023.</li>
          <li>“The effect of dark non-standard interactions on the CP-phase measurement at DUNE (Poster)” — ICRC 2023.</li>
        </ul>
      </section>

      <section class="about-actions">
        <a href="/website/CV_DBB.pdf" class="cv-button" target="_blank">Download Full CV</a>
        <a href="https://inspirehep.net/literature?sort=mostrecent&size=25&page=1&q=Dharitree%20Bezboruah" class="text-link" target="_blank" rel="noopener">iNSPIRE-HEP ↗</a>
      </section>
    </main>

    <Footer />
  </body>
</html>
