---
const { showHomeIcon = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!-- Kalpurush is used automatically for Assamese/Bengali-script text anywhere on the site. -->
<link rel="stylesheet" href="https://banglawebfonts.pages.dev/css/kalpurush.css">

<header class="site-header">
  <a href={`${base}/`} class="site-name">Dharitree Bezboruah</a>
  <nav>
    {showHomeIcon && (
      <a href={`${base}/`} class="home-icon" aria-label="Home" title="Home">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5v9a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1v-9Z" />
        </svg>
      </a>
    )}
    <a href={`${base}/about/`}>About</a>
    <a href={`${base}/blog/`}>Blog</a>
    <a href={`${base}/gallery/`}>Gallery</a>
  </nav>
</header>

<style is:global>
  /* Shared header — deliberately matches the landing page header */
  .site-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 5vw;
    background: #093a41;
    color: #dfdccb;
    font-family: "Times New Roman", Times, serif !important;
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1000;
  }

  .site-header .site-name {
    margin: 0;
    padding: 0;
    color: #dfdccb !important;
    text-decoration: none;
    font-family: "Times New Roman", Times, serif !important;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 30px;
    margin: 0;
    padding: 0;
    font-family: "Times New Roman", Times, serif !important;
  }

  .site-header nav a {
    margin: 0;
    padding: 0;
    color: #dfdccb !important;
    text-decoration: none;
    font-family: "Times New Roman", Times, serif !important;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
    position: relative;
  }

  .site-header nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 0;
    height: 1px;
    background: #ff004f;
    transition: width 0.3s ease;
  }

  .site-header nav a:hover::after {
    width: 100%;
  }

  .site-header nav .home-icon {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .site-header nav .home-icon::after {
    display: none;
  }

  .site-header nav .home-icon svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .site-header nav .home-icon:hover {
    opacity: 0.65;
  }

  /*
   * Any Assamese/Bengali-script text is wrapped by the shared script below.
   * English and other Latin text continues to use each page's normal font.
   */
  .assamese-text {
    font-family: "Kalpurush", sans-serif !important;
  }

  @media (max-width: 700px) {
    .site-header {
      padding: 25px;
    }

    .site-header nav {
      gap: 15px;
    }

    .site-header nav a {
      font-size: 12px;
    }

    .site-header nav .home-icon,
    .site-header nav .home-icon svg {
      width: 16px;
      height: 16px;
    }

    .site-header .site-name {
      font-size: 14px;
    }
  }
</style>

<script is:inline>
  (() => {
    const ASSAMESE = /[\u0980-\u09FF]/;
    const SCRIPT_RUN = /[\u0980-\u09FF]+(?:[\u200C\u200D][\u0980-\u09FF]+)*/g;

    function wrapAssamese(root) {
      if (!root) return;

      const walker = document.createTreeWalker(
        root,
        NodeFilter.SHOW_TEXT,
        {
          acceptNode(node) {
            if (!node.nodeValue || !ASSAMESE.test(node.nodeValue)) {
              return NodeFilter.FILTER_REJECT;
            }

            const parent = node.parentElement;
            if (!parent || parent.closest(".assamese-text, script, style, textarea")) {
              return NodeFilter.FILTER_REJECT;
            }

            return NodeFilter.FILTER_ACCEPT;
          }
        }
      );

      const nodes = [];
      let node;
      while ((node = walker.nextNode())) nodes.push(node);

      nodes.forEach(textNode => {
        const text = textNode.nodeValue;
        const fragment = document.createDocumentFragment();
        let last = 0;
        let match;

        SCRIPT_RUN.lastIndex = 0;
        while ((match = SCRIPT_RUN.exec(text)) !== null) {
          if (match.index > last) {
            fragment.appendChild(document.createTextNode(text.slice(last, match.index)));
          }

          const span = document.createElement("span");
          span.className = "assamese-text";
          span.textContent = match[0];
          fragment.appendChild(span);
          last = SCRIPT_RUN.lastIndex;
        }

        if (last < text.length) {
          fragment.appendChild(document.createTextNode(text.slice(last)));
        }

        textNode.parentNode.replaceChild(fragment, textNode);
      });
    }

    function initAssameseFont() {
      wrapAssamese(document.body);

      const observer = new MutationObserver(mutations => {
        for (const mutation of mutations) {
          mutation.addedNodes.forEach(node => {
            if (node.nodeType === Node.ELEMENT_NODE) {
              wrapAssamese(node);
            } else if (node.nodeType === Node.TEXT_NODE) {
              wrapAssamese(node.parentElement);
            }
          });
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAssameseFont, { once: true });
    } else {
      initAssameseFont();
    }
  })();
</script>
