---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/about.css";
---

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>About — Dharitree Bezboruah</title>

  <link
    rel="stylesheet"
    href="https://kit.fontawesome.com/2d462008c1.js"
  />

  <link
    rel="stylesheet"
    href="https://banglawebfonts.pages.dev/css/kalpurush.css"
  />
</head>

<body>

  <Header />

  <main class="about-page">

    <section class="about-content">

      <div class="about-image">
        <img
          src="/website/images/my_img.jpeg"
          alt="Dharitree Bezboruah"
        />
      </div>


      <div class="about-text">

        <!-- ENGLISH -->

        <div id="english-content">

          <p class="about-label">
            A little about me
          </p>

          <h1>
            Dharitree Bezboruah
          </h1>

          <p>
            Hi, I'm Dharitree Bezboruah, a research scholar in the
            Department of Physics at Tezpur University, Assam.
            My research focuses on astroparticle physics, and I am
            currently working under the supervision of Dr. Moon Moon Devi.
          </p>

          <p>
            If you'd like to know more about my academic background,
            you can download my
            <a
              href="/website/CV_DBB.pdf"
              target="_blank"
            >
              CV
            </a>.
          </p>

          <p>
            Curious about my research? Feel free to explore my work on
            <a
              href="https://inspirehep.net/literature?sort=mostrecent&size=25&page=1&q=Dharitree%20Bezboruah"
              target="_blank"
            >
              iNSPIRE-HEP
            </a>.
          </p>

        </div>


        <!-- ASSAMESE -->

        <div
          id="assamese-content"
          hidden
        >

          <p class="about-label">
            মোৰ বিষয়ে অলপ
          </p>

          <h1>
            ধৰিত্ৰী বেজৱৰুৱা
          </h1>

          <p>
            মই ধৰিত্ৰী। তেজপুৰ বিশ্ববিদ্যালয়ৰ পদাৰ্থবিজ্ঞান
            বিভাগৰ এগৰাকী গৱেষণা ছাত্ৰী। মই বৰ্তমান ড° মুনমুন
            দেৱীৰ তত্বাৱধানত জ্যোতিপদাৰ্থবিজ্ঞান আৰু নিউট্ৰিনো
            নামৰ মৌলিক কণাবোৰৰ বিষয়ে গৱেষণাৰত।
          </p>

          <p>
            আপোনালোকে মোৰ গৱেষণাৰ বিৱৰণৰ বাবে আগ্ৰহী হ’লে
            মোৰ
            <a
              href="https://inspirehep.net/literature?sort=mostrecent&size=25&page=1&q=Dharitree%20Bezboruah"
              target="_blank"
            >
              iNSPIRE-HEP
            </a>
            একাউণ্টটো চাব পাৰে।
          </p>

          <p>
            মোৰ শৈক্ষিক পটভূমিৰ বিষয়ে অধিক জানিবলৈ মোৰ
            <a
              href="/website/CV_DBB.pdf"
              target="_blank"
            >
              CV
            </a>
            ডাউনলোড কৰিব পাৰে।
          </p>

        </div>


        <button
          id="language-toggle"
          type="button"
        >
          অসমীয়া
        </button>

      </div>

    </section>

  </main>

  <Footer />

  <script>
    const toggle = document.getElementById("language-toggle");
    const english = document.getElementById("english-content");
    const assamese = document.getElementById("assamese-content");

    toggle?.addEventListener("click", () => {

      const englishVisible = !english?.hasAttribute("hidden");

      if (englishVisible) {
        english?.setAttribute("hidden", "");
        assamese?.removeAttribute("hidden");

        if (toggle) toggle.textContent = "English";

      } else {
        assamese?.setAttribute("hidden", "");
        english?.removeAttribute("hidden");

        if (toggle) toggle.textContent = "অসমীয়া";
      }

    });
  </script>

</body>
</html>
