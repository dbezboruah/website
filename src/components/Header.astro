---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="site-header">
  <a href={`${base}/`} class="site-name">Dharitree Bezboruah</a>
  <nav>
    <a href={`${base}/about/`}>About</a>
    <a href={`${base}/blog/`}>Blog</a>
    <a href={`${base}/gallery/`}>Gallery</a>
  </nav>
</header>

<style is:global>
  /* Shared header — deliberately matches the landing page header */
  .site-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 5vw;
    background: #093a41;
    color: #dfdccb;
    font-family: "Times New Roman", Times, serif !important;
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1000;
  }

  .site-header .site-name {
    margin: 0;
    padding: 0;
    color: #dfdccb !important;
    text-decoration: none;
    font-family: "Times New Roman", Times, serif !important;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 30px;
    margin: 0;
    padding: 0;
    font-family: "Times New Roman", Times, serif !important;
  }

  .site-header nav a {
    margin: 0;
    padding: 0;
    color: #dfdccb !important;
    text-decoration: none;
    font-family: "Times New Roman", Times, serif !important;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
    position: relative;
  }

  .site-header nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 0;
    height: 1px;
    background: #ff004f;
    transition: width 0.3s ease;
  }

  .site-header nav a:hover::after {
    width: 100%;
  }

  @media (max-width: 700px) {
    .site-header {
      padding: 25px;
    }

    .site-header nav {
      gap: 15px;
    }

    .site-header nav a {
      font-size: 12px;
    }

    .site-header .site-name {
      font-size: 14px;
    }
  }
</style>
