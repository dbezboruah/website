---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/blog.css";

const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>বেবেৰিবাং — Blog</title>

  <!-- Kalpurush web font for Assamese/Bengali script -->
  <link href="https://fonts.maateen.me/kalpurush/font.css" rel="stylesheet">

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/2d462008c1.js" crossorigin="anonymous"></script>
</head>

<body class="body_container">
  <Header />

  <div class="blog-subtitle">
    <p>
      <span class="assamese-title">বেবেৰিবাং</span>
      <span class="english-title"> : A Nonsensical Ode</span>
    </p>
  </div>

  <main class="blog_container" id="blogList">
    <p class="loading">Loading...</p>
  </main>

  <main class="article_container" id="articleView" style="display:none;"></main>

  <Footer />

  <script is:inline define:vars={{ base }}>
    const POSTS_FILE = `${base}posts.json`;

    /* Apply Kalpurush only to Assamese/Bengali Unicode characters.
       English text remains Times New Roman. */
    function applyAssameseFont(root) {
      if (!root) return;

      const walker = document.createTreeWalker(
        root,
        NodeFilter.SHOW_TEXT,
        {
          acceptNode(node) {
            if (!node.nodeValue || !/[\u0980-\u09FF]/.test(node.nodeValue)) {
              return NodeFilter.FILTER_REJECT;
            }
            if (node.parentElement && node.parentElement.closest(".assamese-text")) {
              return NodeFilter.FILTER_REJECT;
            }
            return NodeFilter.FILTER_ACCEPT;
          }
        }
      );

      const nodes = [];
      let node;
      while ((node = walker.nextNode())) nodes.push(node);

      nodes.forEach(textNode => {
        const text = textNode.nodeValue;
        const fragment = document.createDocumentFragment();
        let last = 0;
        const regex = /[\u0980-\u09FF]+(?:[\u200C\u200D][\u0980-\u09FF]+)*/g;
        let match;

        while ((match = regex.exec(text)) !== null) {
          if (match.index > last) {
            fragment.appendChild(document.createTextNode(text.slice(last, match.index)));
          }

          const span = document.createElement("span");
          span.className = "assamese-text";
          span.textContent = match[0];
          fragment.appendChild(span);
          last = regex.lastIndex;
        }

        if (last < text.length) {
          fragment.appendChild(document.createTextNode(text.slice(last)));
        }

        textNode.parentNode.replaceChild(fragment, textNode);
      });
    }

    async function loadPosts() {
      const blogList = document.getElementById("blogList");

      try {
        const response = await fetch(POSTS_FILE + "?t=" + Date.now());

        if (!response.ok) {
          throw new Error("Could not load posts.json. Status: " + response.status);
        }

        const posts = await response.json();

        if (!Array.isArray(posts) || posts.length === 0) {
          blogList.innerHTML = `<p class="no-posts">No posts available.</p>`;
          return;
        }

        window.blogPosts = posts;
        handleURL();
      } catch (error) {
        console.error("Blog loading error:", error);
        blogList.innerHTML = `
          <div class="error-message">
            <p>Unable to load posts.</p>
            <small>${escapeHTML(error.message)}</small>
          </div>
        `;
      }
    }

    function showAllPosts() {
      const blogList = document.getElementById("blogList");
      const articleView = document.getElementById("articleView");

      articleView.style.display = "none";
      blogList.style.display = "grid";
      blogList.innerHTML = "";

      if (!window.blogPosts || window.blogPosts.length === 0) {
        blogList.innerHTML = `<p class="no-posts">No posts available.</p>`;
        return;
      }

      window.blogPosts.forEach(post => blogList.appendChild(createPost(post)));
      applyAssameseFont(blogList);

      if (window.location.hash) {
        history.replaceState(null, "", window.location.pathname);
      }

      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function createPost(post) {
      const article = document.createElement("article");
      article.className = "post_preview";

      const title = post.title || "Untitled";
      const date = formatDate(post.date);
      const excerpt = post.excerpt || "";

      article.innerHTML = `
        <div>
          <div class="post_preview_date">${date}</div>
          <h2 class="post_preview_title">${escapeHTML(title)}</h2>
          <div class="post_preview_excerpt">${escapeHTML(excerpt)}</div>
        </div>
        <a href="#post-${encodeURIComponent(post.id)}" class="read_link">Read story →</a>
      `;

      article.querySelector(".read_link").addEventListener("click", function(event) {
        event.preventDefault();
        history.pushState(null, "", "#post-" + encodeURIComponent(post.id));
        showPost(post);
      });

      return article;
    }

    function showPost(post) {
      const blogList = document.getElementById("blogList");
      const articleView = document.getElementById("articleView");

      blogList.style.display = "none";
      articleView.style.display = "block";

      articleView.innerHTML = `
        <article class="article">
          <a href="#" class="back_link" id="backTop">← All posts</a>
          <div class="article_date">${formatDate(post.date)}</div>
          <h1 class="article_title">${escapeHTML(post.title)}</h1>
          <div class="article_content">${post.content || ""}</div>
          <div class="article_bottom">
            <a href="#" class="back_link" id="backBottom">← Back to all posts</a>
          </div>
        </article>
      `;

      applyAssameseFont(articleView);

      document.getElementById("backTop").addEventListener("click", function(event) {
        event.preventDefault();
        showAllPosts();
      });

      document.getElementById("backBottom").addEventListener("click", function(event) {
        event.preventDefault();
        showAllPosts();
      });

      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    window.addEventListener("popstate", function() {
      handleURL();
    });

    function handleURL() {
      if (!window.blogPosts) return;

      const hash = window.location.hash;

      if (hash.startsWith("#post-")) {
        const id = decodeURIComponent(hash.substring(6));
        const post = window.blogPosts.find(item => item.id === id);

        if (post) {
          showPost(post);
          return;
        }
      }

      showAllPosts();
    }

    function formatDate(dateString) {
      if (!dateString) return "";

      const date = new Date(dateString);
      return date.toLocaleDateString("en-IN", {
        year: "numeric",
        month: "long",
        day: "numeric"
      });
    }

    function escapeHTML(text) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    loadPosts();
  </script>
</body>
</html>
