---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/blog.css";
import "../styles/gallery.css";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Though my lens — Dharitree Bezboruah</title>
  <script src="https://kit.fontawesome.com/2d462008c1.js" crossorigin="anonymous"></script>
</head>
<body>
  <Header />

  <main class="gallery-page">
    <div class="gallery-intro">
      <h1>Though my lens</h1>
      <p>I love travel, food, cinema. Feel free to browse some of my snapshots.</p>
    </div>

    <div class="gallery-grid" id="galleryGrid" aria-live="polite"></div>
  </main>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close photo viewer">&times;</button>
    <button class="lightbox-prev" id="lightboxPrev" aria-label="Previous photo">&#10094;</button>
    <img class="lightbox-image" id="lightboxImage" src="" alt="" />
    <button class="lightbox-next" id="lightboxNext" aria-label="Next photo">&#10095;</button>
    <div class="lightbox-caption" id="lightboxCaption"></div>
  </div>

  <Footer />

  <script is:inline>
    /*
     * The gallery page is /website/gallery/ while gallery.json is at
     * /website/gallery.json. Using a relative URL here avoids the previous
     * __BASE_URL__ placeholder problem in an is:inline script.
     */
    const dataURL = new URL("../gallery.json", document.baseURI);
    const galleryRootURL = new URL("../gallery/", document.baseURI);

    const galleryGrid = document.getElementById("galleryGrid");
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightboxImage");
    const lightboxCaption = document.getElementById("lightboxCaption");
    const lightboxClose = document.getElementById("lightboxClose");
    const lightboxPrev = document.getElementById("lightboxPrev");
    const lightboxNext = document.getElementById("lightboxNext");

    let galleryImages = [];
    let currentIndex = 0;

    function imageURL(filename) {
      return new URL(encodeURIComponent(filename), galleryRootURL).href;
    }

    function rawImageURL(filename) {
      return `https://raw.githubusercontent.com/dbezboruah/website/main/public/gallery/${encodeURIComponent(filename)}`;
    }

    function openLightbox(index) {
      if (!galleryImages.length) return;

      currentIndex = (index + galleryImages.length) % galleryImages.length;
      const image = galleryImages[currentIndex];
      const src = imageURL(image.filename);

      lightboxImage.src = src;
      lightboxImage.dataset.fallback = rawImageURL(image.filename);
      lightboxImage.alt = image.filename;
      lightboxCaption.textContent = image.filename;
      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.classList.add("lightbox-open");
    }

    function closeLightbox() {
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.classList.remove("lightbox-open");
      lightboxImage.removeAttribute("src");
    }

    function showPrevious() {
      openLightbox(currentIndex - 1);
    }

    function showNext() {
      openLightbox(currentIndex + 1);
    }

    function createGalleryCard(image, index) {
      const item = document.createElement("button");
      item.type = "button";
      item.className = "gallery-item";
      item.setAttribute("aria-label", `Open ${image.filename}`);

      const img = document.createElement("img");
      img.src = imageURL(image.filename);
      img.alt = image.filename;
      img.loading = "lazy";
      img.decoding = "async";
      img.dataset.fallback = rawImageURL(image.filename);

      img.addEventListener("error", function () {
        if (this.src !== this.dataset.fallback) {
          this.src = this.dataset.fallback;
        }
      });

      item.appendChild(img);
      item.addEventListener("click", () => openLightbox(index));
      return item;
    }

    async function loadGallery() {
      try {
        const response = await fetch(`${dataURL.href}?t=${Date.now()}`, {
          cache: "no-store"
        });

        if (!response.ok) {
          throw new Error(`Could not load gallery.json (${response.status})`);
        }

        const data = await response.json();
        galleryImages = Array.isArray(data) ? data : [];
        galleryGrid.innerHTML = "";

        if (!galleryImages.length) {
          galleryGrid.innerHTML = '<p class="gallery-error">No photos available.</p>';
          return;
        }

        galleryImages.forEach((image, index) => {
          galleryGrid.appendChild(createGalleryCard(image, index));
        });
      } catch (error) {
        console.error("Gallery loading error:", error);
        galleryGrid.innerHTML = '<p class="gallery-error">Unable to load gallery.</p>';
      }
    }

    lightboxImage.addEventListener("error", function () {
      if (this.src !== this.dataset.fallback) {
        this.src = this.dataset.fallback;
      }
    });

    lightboxClose.addEventListener("click", closeLightbox);
    lightboxPrev.addEventListener("click", showPrevious);
    lightboxNext.addEventListener("click", showNext);

    lightbox.addEventListener("click", function (event) {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", function (event) {
      if (!lightbox.classList.contains("is-open")) return;

      if (event.key === "Escape") closeLightbox();
      if (event.key === "ArrowLeft") showPrevious();
      if (event.key === "ArrowRight") showNext();
    });

    loadGallery();
  </script>
</body>
</html>
